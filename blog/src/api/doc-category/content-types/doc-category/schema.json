{
  "kind": "collectionType",
  "collectionName": "doc_categories",
  "info": {
    "singularName": "doc-category",
    "pluralName": "doc-categories",
    "displayName": "Doc Category",
    "description": "Documentation categories"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "icon": {
      "type": "string",
      "default": "HelpOutline"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "doc_articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::doc-article.doc-article",
      "mappedBy": "category"
    }
  }
}
